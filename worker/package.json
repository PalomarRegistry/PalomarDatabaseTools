{
  "name": "palomar-public-data-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=low",
    "check": "tsc --noEmit",
    "check:tests": "tsc --noEmit --project test/runtime/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "types": "wrangler types --env-interface Env"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@types/node": "24.2.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
