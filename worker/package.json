{
  "name": "palomar-public-data-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=low",
    "check": "tsc --noEmit",
    "check:tests": "tsc --noEmit --project test/runtime/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "types": "wrangler types --env-interface Env"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "26.6.5",
    "typescript": "5.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "wrangler": "$wrangler",
    "miniflare": "5.20261006.1-alpha"
  }
}
